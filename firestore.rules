rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 只有這個使用者 UID 是管理員（Firebase 控制台 → Authentication → Users → 使用者 UID）。
    // 用 UID 而不是信箱：就算有人用同樣格式的信箱去註冊，也拿不到管理員權限。
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'ULYB6kVOtNMmYFgZMjZvyyHCmeS2';
    }

    function validAnnouncement(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.body is string && d.body.size() <= 5000
        && d.category in ['公告', '活動', '須知', '緊急']
        && d.pinned is bool
        && d.published is bool
        && d.no is int
        && (!('commentsOpen' in d) || d.commentsOpen is bool);
    }

    function validTodo(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.detail is string && d.detail.size() <= 2000
        && d.done is bool
        && d.createdBy is string && d.createdBy.size() <= 20
        && (!('order' in d) || (d.order is int && d.order >= 0 && d.order <= 100000));
    }

    // 內部公告：kind 'post' 是一般公告（標題＋內容＋選填的附圖或影片）；
    // 'link' 是快速連結（名稱＋內容＋選填的縮圖，點下去開 url，所以一定要有 url）。
    // media 是 media/ 資料夾裡的相對路徑或 http(s) 網址；order 只用來讓同一批匯入的項目維持檔案裡的先後順序。
    function validInternal(d) {
      return d.kind in ['post', 'link']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.body is string && d.body.size() <= 5000
        && d.media is string && d.media.size() <= 500
        && (d.media == '' || d.media.matches('^(media/|https?://).*'))
        && d.url is string && d.url.size() <= 1000
        && (d.url == '' || d.url.matches('^https?://.*'))
        && (d.kind == 'post' || d.url != '')
        && d.createdBy is string && d.createdBy.size() <= 20
        && (!('order' in d) || (d.order is int && d.order >= 0 && d.order <= 100000));
    }

    // 留言格式：欄位固定，暱稱 1–20 字，內容 1–500 字，時間必須是伺服器時間。
    // byAdmin 為 true 代表群主的回覆（前台會顯示「群主」標章），讀者留言只能是 false。
    function validComment(d, byAdmin) {
      return d.keys().hasOnly(['name', 'text', 'fromAdmin', 'createdAt'])
        && d.keys().hasAll(['name', 'text', 'fromAdmin', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.fromAdmin == byAdmin
        && d.createdAt == request.time;
    }

    function announcementPublished(aid) {
      return get(/databases/$(database)/documents/announcements/$(aid)).data.published == true;
    }

    // 已發布，而且沒有被關閉留言（舊公告沒有 commentsOpen 欄位，視為開放）
    function announcementOpen(aid) {
      return announcementPublished(aid)
        && get(/databases/$(database)/documents/announcements/$(aid)).data.get('commentsOpen', true) == true;
    }

    // 公告：任何人只能讀「已發布」的；草稿只有管理員看得到
    match /announcements/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validAnnouncement(request.resource.data);
      allow delete: if isAdmin();

      // 公告留言：任何人可以讀已發布公告的留言，也可以在開放留言的公告下新增；
      // 不能修改；只有管理員能刪除。
      match /comments/{commentId} {
        allow read: if isAdmin() || announcementPublished(id);
        allow create: if (isAdmin() && validComment(request.resource.data, true))
                      || (announcementOpen(id) && validComment(request.resource.data, false));
        allow delete: if isAdmin();
      }
    }

    // 待辦事項與其留言：只有管理員看得到、寫得進去
    match /todos/{todoId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validTodo(request.resource.data);

      match /comments/{commentId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin() && validComment(request.resource.data, true);
      }
    }

    // 內部公告：只有管理員看得到、寫得進去（前台讀者看不到）
    match /internal/{itemId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validInternal(request.resource.data);
    }

    // 網站設定：任何人可讀，只有管理員能改
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== 私訊（訪客 ↔ 聯絡窗口）=====
    //
    //   contacts/{cid}                                        聯絡窗口。cid 由窗口名稱算出；uid 是這個窗口的私訊帳號
    //                                                         （空字串 = 尚未建立或已重設）。只有管理員能建立、重設。
    //   contacts/{cid}/threads/{vid}                          某位訪客與這個窗口的整串對話。vid 是訪客瀏覽器自己產生的
    //                                                         32 字元隨機碼，知道它才進得了這串對話（等於鑰匙），別人猜不到。
    //   contacts/{cid}/threads/{vid}/messages/{mid}           一則訊息
    //   contacts/{cid}/threads/{vid}/messages/{mid}/parts/{n} 圖片、GIF、影片、錄音的內容（切成每塊 900000 位元組以內，最多 8 塊）

    function contactDocPath(cid) {
      return /databases/$(database)/documents/contacts/$(cid);
    }

    // 這個窗口已經建立私訊帳號，訪客才傳得了訊息
    function contactOpen(cid) {
      return exists(contactDocPath(cid))
        && get(contactDocPath(cid)).data.uid != '';
    }

    // 目前登入的人，就是這個窗口的私訊帳號
    function isContact(cid) {
      return request.auth != null
        && exists(contactDocPath(cid))
        && get(contactDocPath(cid)).data.uid == request.auth.uid;
    }

    function validContactDoc(cid, d) {
      return cid.matches('^c[a-f0-9]{28}$')
        && d.keys().hasOnly(['name', 'uid', 'gen', 'createdAt'])
        && d.keys().hasAll(['name', 'uid', 'gen', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.uid is string && d.uid.size() <= 128
        && d.gen is int && d.gen >= 0 && d.gen <= 1000
        && d.createdAt == request.time;
    }

    // 媒體種類與檔案格式要對得上（不收 SVG 之類可能夾帶程式的格式）
    function mimeMatchesKind(kind, mime) {
      return (kind == 'image' && mime in ['image/jpeg', 'image/png', 'image/webp'])
        || (kind == 'gif' && mime == 'image/gif')
        || (kind == 'video' && mime in ['video/mp4', 'video/webm', 'video/quicktime'])
        || (kind == 'audio' && mime in ['audio/mp4', 'audio/webm', 'audio/ogg', 'audio/mpeg', 'audio/aac', 'audio/x-m4a']);
    }

    function validMedia(kind, m) {
      return m is map
        && m.keys().hasAll(['mime', 'size', 'parts'])
        && m.keys().hasOnly(['mime', 'size', 'parts', 'dur', 'w', 'h'])
        && m.mime is string && mimeMatchesKind(kind, m.mime)
        && m['size'] is int && m['size'] > 0 && m['size'] <= 6500000
        && m.parts is int && m.parts >= 1 && m.parts <= 8
        && m.parts * 900000 >= m['size'] && (m.parts - 1) * 900000 < m['size']
        && (!('dur' in m) || (m.dur is number && m.dur >= 0 && m.dur <= 25))
        && (!('w' in m) || (m.w is number && m.w > 0 && m.w <= 20000))
        && (!('h' in m) || (m.h is number && m.h > 0 && m.h <= 20000));
    }

    // 訊息：文字 1–1000 字；圖片、GIF、影片、錄音要附 media，另可附說明文字；
    // 時間必須是伺服器時間；side 只能是 visitor（訪客）或 contact（窗口本人）。
    function validMessage(d, side) {
      return d.keys().hasAll(['side', 'kind', 'createdAt'])
        && d.keys().hasOnly(['side', 'kind', 'text', 'media', 'createdAt'])
        && d.side == side
        && d.createdAt == request.time
        && d.kind in ['text', 'image', 'gif', 'video', 'audio']
        && (!('text' in d) || (d.text is string && d.text.size() <= 1000))
        && (d.kind == 'text'
            ? ('text' in d && d.text.size() >= 1 && !('media' in d))
            : ('media' in d && validMedia(d.kind, d.media)));
    }

    // 對話列表上的摘要（最後一則的時間、發話者、預覽）
    function validThreadSummary(d, side) {
      return d.lastSide == side
        && d.lastPreview is string && d.lastPreview.size() <= 80
        && d.lastAt == request.time;
    }

    function validVisitorThread(d) {
      return d.label is string && d.label.size() >= 1 && d.label.size() <= 30
        && validThreadSummary(d, 'visitor');
    }

    // 窗口本人只能改「已讀時間」，或在回覆時更新摘要與已讀時間
    function validContactThreadUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return (changed.hasOnly(['contactReadAt']) && d.contactReadAt == request.time)
        || (changed.hasOnly(['lastAt', 'lastSide', 'lastPreview', 'contactReadAt'])
            && d.contactReadAt == request.time
            && validThreadSummary(d, 'contact'));
    }

    match /contacts/{cid} {
      // 任何人可讀（訪客要知道這個窗口開通了沒有）；裡面只有名稱與帳號 UID
      allow read: if true;
      allow create, update: if isAdmin() && validContactDoc(cid, request.resource.data);
      allow delete: if isAdmin();

      match /threads/{vid} {
        // 單筆讀取不用登入（訪客用自己的 vid 查看自己的對話）；列出所有對話只有窗口本人
        allow get: if true;
        allow list: if isContact(cid);
        allow create: if vid.matches('^[a-f0-9]{32}$')
          && contactOpen(cid)
          && request.resource.data.keys().hasOnly(['label', 'lastAt', 'lastSide', 'lastPreview'])
          && request.resource.data.keys().hasAll(['label', 'lastAt', 'lastSide', 'lastPreview'])
          && validVisitorThread(request.resource.data);
        allow update: if (contactOpen(cid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'lastAt', 'lastSide', 'lastPreview'])
            && validVisitorThread(request.resource.data))
          || (isContact(cid) && validContactThreadUpdate());
        allow delete: if isContact(cid);

        match /messages/{mid} {
          allow read: if true;
          allow create: if (isContact(cid) && validMessage(request.resource.data, 'contact'))
            || (contactOpen(cid) && validMessage(request.resource.data, 'visitor'));
          allow delete: if isContact(cid);

          match /parts/{pid} {
            allow read: if true;
            allow create: if contactOpen(cid)
              && pid.matches('^[0-7]$')
              && request.resource.data.keys().hasOnly(['b'])
              && request.resource.data.b is bytes
              && request.resource.data.b.size() > 0
              && request.resource.data.b.size() <= 900000;
            allow delete: if isContact(cid);
          }
        }
      }
    }
  }
}
